NODE_ENV=development
PORT=4000

# Amazon RDS MySQL
# Replace with your actual RDS endpoint/credentials
DATABASE_URL=mysql://mini_erp_user:YourPassword@your-rds-endpoint.rds.amazonaws.com:3306/mini_erp_crm

# For local development (use this with docker-compose.yml dev variant)
# DATABASE_URL=mysql://root:devpassword@localhost:3306/mini_erp_crm

JWT_SECRET=your-64-char-random-secret-here-replace-before-production
JWT_EXPIRES_IN=8h

SHOW_TEST_CREDENTIALS=true

# CORS — set to your frontend URL
CORS_ORIGIN=http://localhost:5173
